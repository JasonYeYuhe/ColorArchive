# Resend API key — get from resend.com (free: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Your "from" address — must be a verified domain in Resend
FROM_EMAIL=hello@colorarchive.me

# Lemon Squeezy webhook secret — Settings > Webhooks in LS dashboard
LS_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Port (default 3001)
PORT=3001

# Frontend origin for CORS
FRONTEND_ORIGIN=https://colorarchive.me
