# Resend API key — get from resend.com (free: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Your "from" address — must be a verified domain in Resend
FROM_EMAIL=hello@colorarchive.org

# Stripe webhooks are handled by the Next.js API route (/api/webhook)
# No webhook secret needed on the Express server

# Port (default 3001)
PORT=3001

# Shared secret for bearer-auth on admin publish routes
# (Pinterest /admin/*, Instagram /publish). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=change-me-to-a-32-byte-hex-string

# Frontend origin for CORS (also used for email links, display text, etc.)
FRONTEND_ORIGIN=https://colorarchive.org

# Shared secret between Next.js webhook forwarder and Express backend
INTERNAL_WEBHOOK_SECRET=

# Optional: comma-separated analytics admins who can access /analytics and admin order tools
ADMIN_EMAILS=hello@colorarchive.org

# Optional: Google OAuth for account sign-in
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://api.colorarchive.org/auth/google/callback

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Instagram API (Instagram Login approach)
# Get from Meta Developer Portal → Apps → ColorArchive → Instagram API
INSTAGRAM_APP_ID=2136241477198779
INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_REDIRECT_URI=https://api.colorarchive.org/instagram/auth/callback

# Optional: Pinterest API (v5) — Standard access, approved 2026-04-15
# Get from Pinterest Developer Portal → Apps → App 1559553 (ColorArchive Pin Saver)
PINTEREST_APP_ID=1559553
PINTEREST_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional dev-only escape hatch; leave unset in production (defaults to production API).
# PINTEREST_SANDBOX=true
# Long-lived user access token (owned by the ColorArchive Pinterest account) used
# by the autopilot/admin publish flow (Phase 2). Generate from the Dev Portal or
# the OAuth exchange; scope must include boards:write + pins:write.
# PINTEREST_ADMIN_TOKEN=pina_xxxxxxxxxxxx
