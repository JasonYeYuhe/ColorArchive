{
  "name": "colorarchive",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-downloads.mjs",
    "build": "next build",
    "generate-downloads": "node scripts/generate-downloads.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run && npm run test:server",
    "test:watch": "vitest",
    "test:server": "node --test 'server/__tests__/*.test.js'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.50.0",
    "@vercel/analytics": "^2.0.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "next": "16.1.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "prettier": "^3.8.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.0"
  }
}
