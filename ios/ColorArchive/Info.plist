<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>me.colorarchive</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>colorarchive</string>
			</array>
		</dict>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ColorArchive uses your photo library to extract dominant colors from images.</string>
	<!-- App only uses exempt encryption (standard HTTPS) — no custom crypto. Skips the
	     per-build export-compliance prompt in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
